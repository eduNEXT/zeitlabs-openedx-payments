# Requirements for test runs.

-r base.in               # Core dependencies for this package

# unit-test packages and dependencies
code-annotations                # provides commands used by the pii_check make target.
ddt                             # data-driven-tests for unittest
edx-lint                        # linter with openedx-platform specifics
deepdiff                        # for deep comparison of objects
numpy                           # required by deepdiff
pytest-cov                      # pytest extension for code coverage statistics
pytest-django                   # pytest extension for better Django support
types-python-dateutil           # needed for mypy to understand python-dateutil


# edx-platform related requirements
babel
djangorestframework
edx-django-utils
edx-opaque-keys[django]
edx-toggles
